<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_ca_slips" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_ca_contractor_slips</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="fiscal_position_id" position="after">
                <field name="l10n_ca_slip_type"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt') or country_code != 'CA'"
                       placeholder="Follows the vendor"
                       groups="account.group_account_manager"/>
            </field>
        </field>
    </record>
</odoo>
