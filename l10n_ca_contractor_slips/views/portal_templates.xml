<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_slips" name="Tax slips" inherit_id="portal.portal_my_home" priority="25">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_vendor_category_enable" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='portal_vendor_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/l10n_ca_contractor_slips/static/src/img/slip.svg'"/>
                <t t-set="title">Tax slips</t>
                <t t-set="text">View and download the T4A and T5018 slips we issued to you</t>
                <t t-set="url" t-value="'/my/slips'"/>
                <t t-set="placeholder_count" t-value="'l10n_ca_slip_count'"/>
            </t>
        </xpath>
    </template>
    <template id="portal_breadcrumbs_slips" inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'l10n_ca_slip'" t-attf-class="breadcrumb-item #{'active ' if not slip else ''}">
                <a t-if="slip" href="/my/slips">Tax slips</a>
                <t t-else="">Tax slips</t>
            </li>
            <li t-if="page_name == 'l10n_ca_slip' and slip" class="breadcrumb-item active">
                <t t-out="slip.display_name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_slips" name="My tax slips">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar"><t t-set="title">Tax slips</t></t>
            <p t-if="not slips" class="alert alert-info">No tax slips have been issued to you yet.</p>
            <t t-if="slips" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Slip</th>
                        <th>Year</th>
                        <th>Issued by</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">PDF</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="slips" t-as="slip">
                        <td><a t-att-href="slip.get_portal_url()" t-out="(slip.slip_type or '').upper()"/>
                            <span t-if="slip.rpt_tcd == 'A'" class="badge text-bg-warning ms-1">Amended</span>
                            <span t-if="slip.rpt_tcd == 'C'" class="badge text-bg-danger ms-1">Cancelled</span></td>
                        <td t-out="slip.year"/>
                        <td t-out="slip.company_id.sudo().name"/>
                        <td class="text-end" t-out="slip.amount_reported" t-options="{'widget': 'monetary', 'display_currency': slip.currency_id}"/>
                        <td class="text-end"><a t-att-href="slip.get_portal_url(report_type='pdf', download=True)">Download</a></td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_slip_page" name="Tax slip">
        <t t-call="portal.portal_layout">
            <div class="card mt-3">
                <div class="card-body">
                    <h3 class="card-title" t-out="slip.display_name"/>
                    <p class="mb-1">Issued by <strong t-out="slip.company_id.sudo().name"/></p>
                    <p class="mb-1" t-if="slip.slip_type == 't4a'">Box 048, fees for services:
                        <strong t-out="slip.amount_reported" t-options="{'widget': 'monetary', 'display_currency': slip.currency_id}"/></p>
                    <p class="mb-1" t-else="">Box 22, construction subcontractor payments:
                        <strong t-out="slip.amount_reported" t-options="{'widget': 'monetary', 'display_currency': slip.currency_id}"/></p>
                    <p class="alert alert-warning" t-if="slip.rpt_tcd == 'C'">This slip was cancelled. Do not use it on your tax return. Contact the payer if you need a replacement slip.</p>
                    <p class="text-muted small">The PDF shows the boxes that apply to you. Keep it for your tax return. If you would rather have paper copies, ask the payer and they will mail them.</p>
                    <a class="btn btn-primary" t-att-href="slip.get_portal_url(report_type='pdf', download=True)">
                        <i class="fa fa-download me-1"/>Download PDF</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
