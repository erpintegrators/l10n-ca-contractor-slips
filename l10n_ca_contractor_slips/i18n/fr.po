#. module: l10n_ca_contractor_slips
#: model:mail.template,body_html:l10n_ca_contractor_slips.mail_template_l10n_ca_slip
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        <t t-if=\"object.rpt_tcd == 'C'\">\n"
"            The <t t-out=\"(object.slip_type or '').upper()\">T4A</t> slip for <t t-out=\"object.year\">2026</t> that\n"
"            <t t-out=\"object.company_id.name or ''\">YourCompany</t> issued to you has been cancelled, and the\n"
"            Canada Revenue Agency has been told. The attached copy is marked cancelled. Do not use the earlier\n"
"            slip on your tax return.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            Your <t t-out=\"(object.slip_type or '').upper()\">T4A</t> slip for <t t-out=\"object.year\">2026</t> is attached.\n"
"            It reports <strong t-out=\"format_amount(object.amount_reported, object.currency_id)\">$1,000.00</strong>\n"
"            paid to you by <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"            <t t-if=\"object.rpt_tcd == 'A'\">It replaces the slip issued to you earlier for the same period.</t>\n"
"        </t>\n"
"        <br/><br/>\n"
"        If you would rather receive paper copies, reply to this email and we will mail them.\n"
"        If anything on the slip looks wrong, tell us and we will correct it.\n"
"        <br/><br/>\n"
"        <t t-out=\"object.company_id.name or ''\">YourCompany</t>\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Bonjour <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        <t t-if=\"object.rpt_tcd == 'C'\">\n"
"            Le feuillet <t t-out=\"(object.slip_type or '').upper()\">T4A</t> de <t t-out=\"object.year\">2026</t> que\n"
"            <t t-out=\"object.company_id.name or ''\">YourCompany</t> vous a remis a été annulé, et\n"
"            l'Agence du revenu du Canada en a été informée. La copie jointe porte la mention annulé. N'utilisez pas\n"
"            le feuillet précédent dans votre déclaration de revenus.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            Votre feuillet <t t-out=\"(object.slip_type or '').upper()\">T4A</t> de <t t-out=\"object.year\">2026</t> est joint.\n"
"            Il déclare <strong t-out=\"format_amount(object.amount_reported, object.currency_id)\">$1,000.00</strong>\n"
"            qui vous ont été payés par <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"            <t t-if=\"object.rpt_tcd == 'A'\">Il remplace le feuillet qui vous a été remis pour la même période.</t>\n"
"        </t>\n"
"        <br/><br/>\n"
"        Si vous préférez recevoir des copies papier, répondez à ce courriel et nous vous les posterons.\n"
"        Si quelque chose semble inexact sur le feuillet, dites-le-nous et nous le corrigerons.\n"
"        <br/><br/>\n"
"        <t t-out=\"object.company_id.name or ''\">YourCompany</t>\n"
"    </p>\n"
"</div>\n"
"        "

