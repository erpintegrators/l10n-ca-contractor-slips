#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid " (amended)"
msgstr " (modifiée)"

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_engine.py:0
msgid ""
"%(amount)s paid in the period is not matched to a posted bill and is left "
"out. Match it to its bills and recalculate."
msgstr ""
"%(amount)s payé durant la période n'est rapproché d'aucune facture "
"comptabilisée et n'est pas compté. Rapprochez-le de ses factures et "
"recalculez."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_engine.py:0
msgid ""
"%(amount)s paid in the period settles journal entries (%(entries)s) and is "
"left out, because a journal entry does not say what the money paid for. If "
"it paid for services, record them as a bill on a tagged account, or adjust "
"the slip."
msgstr ""
"%(amount)s payés pendant la période règlent des écritures de journal "
"(%(entries)s) et sont exclus, car une écriture de journal ne dit pas ce que "
"l'argent a payé. S'il s'agit de services, enregistrez-les sur une facture "
"fournisseur avec un compte étiqueté, ou ajustez le feuillet."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_engine.py:0
msgid ""
"%(amount)s paid on %(date)s went to %(account)s, which is not tagged for "
"%(slip)s. If it releases a holdback, tag that account so it counts."
msgstr ""
"%(amount)s payés le %(date)s ont été portés au compte %(account)s, qui n'est"
" pas étiqueté pour le %(slip)s. S'il s'agit de la libération d'une retenue, "
"étiquetez ce compte pour qu'elle compte."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_engine.py:0
msgid ""
"%(bill)s bills %(amount)s to %(account)s, which is not tagged for %(slip)s. "
"If it releases a holdback, tag that account so it counts."
msgstr ""
"%(bill)s facture %(amount)s au compte %(account)s, qui n'est pas étiqueté "
"pour le %(slip)s. S'il s'agit de la libération d'une retenue, étiquetez ce "
"compte pour qu'elle compte."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_engine.py:0
msgid ""
"%(bill)s holds back %(amount)s on %(account)s, which is not tagged for "
"%(slip)s. Tag the holdback account so the release counts when it is paid."
msgstr ""
"%(bill)s retient %(amount)s au compte %(account)s, qui n'est pas étiqueté "
"pour le %(slip)s. Étiquetez le compte de retenues pour que la libération "
"compte lorsqu'elle est payée."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_engine.py:0
msgid ""
"%(bill)s was paid in the period, but none of its lines is on an account "
"tagged for %(slip)s or holds a product, so it is left out. If it paid for "
"services, tag the account and recalculate."
msgstr ""
"%(bill)s a été payée pendant la période, mais aucune de ses lignes n'est sur"
" un compte étiqueté pour le %(slip)s ni ne comporte de produit; elle est "
"donc exclue. S'il s'agit de services, étiquetez le compte et recalculez."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid "%(count)s already emailed were skipped."
msgstr "%(count)s déjà envoyé(s) par courriel ont été ignoré(s)."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid ""
"%(count)s recipient(s) gave consent but have an email address that is not "
"valid: %(names)s. Correct it, or give them their slips another way."
msgstr ""
"%(count)s bénéficiaire(s) ont donné leur consentement, mais leur adresse "
"courriel n'est pas valide : %(names)s. Corrigez-la, ou remettez-leur leurs "
"feuillets autrement."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid ""
"%(count)s recipient(s) have a portal login they have never used, so they are"
" listed for paper."
msgstr ""
"%(count)s bénéficiaire(s) ont un accès au portail qu'ils n'ont jamais "
"utilisé; ils sont donc inscrits pour des copies papier."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid ""
"%(count)s recipient(s) without email consent have a portal account and can "
"download their slip there."
msgstr ""
"%(count)s bénéficiaire(s) sans consentement au courriel ont un compte sur le"
" portail et peuvent y télécharger leur feuillet."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid "%(count)s slip email(s) queued; they go out within a few minutes."
msgstr ""
"%(count)s courriel(s) de feuillet en file d'attente; ils partent d'ici "
"quelques minutes."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_engine.py:0
msgid ""
"%(credit)s was refunded in cash and holds only goods, but is not linked to "
"the bill it corrects, so box 22 is not reduced. Adjust the slip if that bill"
" was reported in full."
msgstr ""
"%(credit)s a été remboursée en argent et ne contient que des biens, mais "
"elle n'est pas liée à la facture qu'elle corrige; la case 22 n'est donc pas "
"réduite. Ajustez le feuillet si cette facture a été déclarée en entier."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/wizard/base_partner_merge.py:0
msgid ""
"%(names)s each have a slip on %(slip_return)s, which is final or filed. "
"Merging would delete one of them. Cancel the duplicate slip in an amendment "
"first, or keep both contacts."
msgstr ""
"%(names)s ont chacun un feuillet dans %(slip_return)s, qui est finalisée ou "
"produite. La fusion en supprimerait un. Annulez d'abord le feuillet en "
"double dans une modification, ou gardez les deux contacts."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/wizard/base_partner_merge.py:0
msgid ""
"%(names)s have final or filed slips with different SINs or business numbers,"
" so they look like different people. Keep both contacts."
msgstr ""
"%(names)s ont des feuillets finalisés ou produits avec des NAS ou des "
"numéros d'entreprise différents; il s'agit donc vraisemblablement de "
"personnes différentes. Conservez les deux contacts."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/wizard/base_partner_merge.py:0
msgid ""
"%(names)s merged into %(kept)s. Their slips on this return now belong to "
"%(kept)s."
msgstr ""
"Fusion de %(names)s dans %(kept)s. Leurs feuillets de cette déclaration "
"appartiennent désormais à %(kept)s."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid ""
"%(other)s already covers part of this period (%(start)s to %(end)s). CRA "
"expects the same reporting period every year unless it authorizes a change "
"in writing."
msgstr ""
"%(other)s couvre déjà une partie de cette période (du %(start)s au %(end)s)."
" L'ARC s'attend à la même période de déclaration chaque année, sauf si elle "
"autorise un changement par écrit."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid ""
"%(partner)s has an address outside Canada and was left out: fees paid to "
"non-residents for services in Canada go on the T4A-NR. If %(partner)s is a "
"resident of Canada, correct the address and recalculate."
msgstr ""
"%(partner)s a une adresse à l'extérieur du Canada et a été exclu : les "
"honoraires versés à des non-résidents pour des services rendus au Canada se "
"déclarent sur le T4A-NR. Si %(partner)s réside au Canada, corrigez l'adresse"
" et recalculez."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid ""
"%(partner)s is flagged for this slip only while working in %(branch)s. Flag "
"the contact while working in %(main)s so its payments count."
msgstr ""
"%(partner)s est indiqué pour ce feuillet seulement dans %(branch)s. "
"Indiquez-le en travaillant dans %(main)s pour que ses paiements soient "
"comptés."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid ""
"%(partner)s is reported on %(other)s, and bills paid in this period use "
"accounts tagged for this slip: %(bills)s. Check which slip those payments "
"belong on."
msgstr ""
"%(partner)s est déclaré sur le %(other)s, et des factures payées pendant "
"cette période utilisent des comptes étiquetés pour ce feuillet : %(bills)s. "
"Vérifiez sur quel feuillet ces paiements doivent figurer."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid ""
"%(partner)s now qualifies but is not on the filed return. Report the slip in"
" a new original return for the same year."
msgstr ""
"Le contact %(partner)s est maintenant admissible, mais il ne figure pas dans"
" la déclaration produite. Incluez le feuillet dans une nouvelle déclaration "
"originale pour la même année."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid ""
"%(partner)s was paid %(amount)s on accounts tagged for this slip, but the "
"contact is not set to %(slip)s. Set Canadian slip on the contact and "
"recalculate, or set those bills to Not reported."
msgstr ""
"%(partner)s a reçu %(amount)s sur des comptes étiquetés pour ce feuillet, "
"mais le contact n'est pas réglé sur %(slip)s. Réglez le feuillet canadien "
"sur le contact et recalculez, ou indiquez Non déclaré sur ces factures."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid ""
"%(partner)s: the slip for this period was cancelled in %(cancelled_in)s "
"(%(note)s). If those payments were not fees for services, set the bills to "
"Not reported and recalculate. File the slip again here only if it was "
"cancelled to correct the SIN or business number."
msgstr ""
"%(partner)s : le feuillet de cette période a été annulé dans "
"%(cancelled_in)s (%(note)s). Si ces paiements n'étaient pas des honoraires "
"pour services, indiquez Non déclaré sur les factures et recalculez. Ne "
"produisez de nouveau le feuillet ici que s'il a été annulé pour corriger le "
"NAS ou le numéro d'entreprise."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip.py:0
msgid "%(recipient)s: %(reason)s"
msgstr "%(recipient)s : %(reason)s"

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/res_company.py:0
msgid ""
"%(value)s is not a 15-character CRA account such as "
"123456789%(program)s0001."
msgstr ""
"%(value)s n'est pas un compte de l'ARC de 15 caractères, comme "
"123456789%(program)s0001."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/res_company.py:0
msgid ""
"%(value)s uses program %(used)s; this filing needs a %(program)s account."
msgstr ""
"%(value)s utilise le programme %(used)s; cette déclaration exige un compte "
"%(program)s."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip.py:0
msgid ""
"%s can no longer send slips. Ask an accounting administrator to click Email "
"slips again."
msgstr ""
"%s ne peut plus envoyer de feuillets. Demandez à un administrateur de la "
"comptabilité de cliquer de nouveau sur Envoyer les feuillets."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/res_company.py:0
msgid "%s has an invalid business number check digit."
msgstr "%s a un chiffre de contrôle de numéro d'entreprise invalide."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_return.py:0
msgid ""
"%s is already reported on another final or filed return for this period."
msgstr ""
"%s est déjà déclaré dans une autre déclaration finalisée ou produite pour "
"cette période."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip.py:0
msgid "%s is not a Canadian postal code (A1A 1A1)."
msgstr "%s n'est pas un code postal canadien (A1A 1A1)."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/res_company.py:0
msgid "%s is not a valid business number or 15-character CRA account."
msgstr ""
"%s n'est ni un numéro d'entreprise valide ni un compte de l'ARC valide de 15"
" caractères."

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/res_company.py:0
msgid "(empty)"
msgstr "(vide)"

