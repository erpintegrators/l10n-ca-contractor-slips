"%(slip)s. If it releases a holdback, tag that account so it counts."
msgstr ""

#. module: l10n_ca_contractor_slips
#. odoo-python
#: code:addons/l10n_ca_contractor_slips/models/l10n_ca_slip_engine.py:0
