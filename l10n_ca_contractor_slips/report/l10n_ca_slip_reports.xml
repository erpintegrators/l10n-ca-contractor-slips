<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Two slips fit on a Letter sheet, each within CRA's 8.5 by 7 inch limit. -->
    <record id="paperformat_l10n_ca_slip" model="report.paperformat">
        <field name="name">Canadian tax slips (Letter)</field>
        <field name="format">Letter</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <!-- Print at true size: CRA asks for text no smaller than on its own slips. -->
        <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="action_report_l10n_ca_slip" model="ir.actions.report">
        <field name="name">Tax slip</field>
        <field name="model">l10n.ca.slip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ca_contractor_slips.report_l10n_ca_slip</field>
        <field name="print_report_name">object._get_report_base_filename()</field>
        <field name="paperformat_id" ref="paperformat_l10n_ca_slip"/>
        <field name="binding_model_id" ref="model_l10n_ca_slip"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
