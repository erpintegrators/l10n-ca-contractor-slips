<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_l10n_ca_slip" model="mail.template">
        <field name="name">Canadian tax slip: send to recipient</field>
        <field name="model_id" ref="model_l10n_ca_slip"/>
        <field name="subject">Your {{ (object.slip_type or '').upper() }} slip for {{ object.year }} from {{ object.company_id.name }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="description">Sent to contractors who agreed to receive tax slips by email</field>
        <!-- Owned by the system user so it never appears in the chatter's template list: the module
             attaches the slip itself when it sends. -->
        <field name="user_id" ref="base.user_root"/>
        <!-- Archived as well, so no template picker offers it; the module sends with it directly. -->
        <field name="active" eval="False"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,
        <br/><br/>
        <t t-if="object.rpt_tcd == 'C'">
            The <t t-out="(object.slip_type or '').upper()">T4A</t> slip for <t t-out="object.year">2026</t> that
            <t t-out="object.company_id.name or ''">YourCompany</t> issued to you has been cancelled.
            The attached copy is marked cancelled. Do not use the earlier
            slip on your tax return.
        </t>
        <t t-else="">
            Your <t t-out="(object.slip_type or '').upper()">T4A</t> slip for <t t-out="object.year">2026</t> is attached.
            It reports <strong t-out="format_amount(object.amount_reported, object.currency_id)">$1,000.00</strong>
            paid to you by <t t-out="object.company_id.name or ''">YourCompany</t>.
            <t t-if="object.rpt_tcd == 'A'">It replaces the slip issued to you earlier for the same period.</t>
        </t>
        <br/><br/>
        If you would rather receive paper copies, reply to this email and we will mail them.
        If anything on the slip looks wrong, tell us and we will correct it.
        <br/><br/>
        <t t-out="object.company_id.name or ''">YourCompany</t>
    </p>
</div>
        </field>
        <field name="lang">{{ object._l10n_ca_slip_lang() }}</field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
